# ==============================================================================
# Required Environment Variables
# ==============================================================================

# MongoDB Connection String (Required - throws error if missing)
CLUSTER_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Google Gemini API Key (Required - throws error if missing)
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# Model & Processing Configuration (Configurable in ENV)
# ==============================================================================

# Gemini Model Name (Optional - defaults to 'gemini-3.6-flash')
GEMINI_MODEL=gemini-3.6-flash

# Number of documents fetched per keyset cursor batch query (Optional - defaults to 20)
BATCH_SIZE=20

# Number of concurrent AI requests processed simultaneously in each sub-chunk (Optional - defaults to 10)
CONCURRENCY=10

# ==============================================================================
# Optional / Defaults Provided Environment Variables
# ==============================================================================

# Super Admin Database Name (Optional - defaults to 'Grinds360-Superadmin-Sandbox')
SUPER_DB_NAME=Grinds360-Superadmin-Sandbox

# Environment Stage (Optional - used to construct tenant DB names like saas-<subdomain>-sandbox/uat/prod)
NODE_ENV=sandbox

# ==============================================================================
# Optional Runtime Overrides & Filtering
# ==============================================================================

# Target a single tenant subdomain instead of all active tenants (Optional)
# SUBDOMAIN=

# Target a specific document _id in aiAnalytics to retry (Optional)
# RECORD_ID=

# Keyset pagination starting cursor / _id (Optional)
# CURSOR=

# Max execution runtime limit in milliseconds before graceful shutdown (Optional)
# MAX_EXECUTION_MS=

# Custom tenant DB name template using {subdomain} placeholder (Optional)
# TENANT_DB_NAME_OVERRIDE=saas-{subdomain}-sandbox
